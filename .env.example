# celery — задачи уходят в очередь модуля scout.
# inline — выполнять в том же процессе. Только для проверки, не для обычного сбора.
SCOUT_TASK_RUNNER=celery

# Для отдельного воркера `ergoms start-worker --module=scout`.
# Порог обновления соединений Django в Celery. 0 — закрывать после каждой задачи.
SCOUT_WORKER_DB_REUSE_MAX=50

# Точные IP и порты доверенных источников через запятую, например 127.0.0.1:8765.
# Пустое значение разрешает только публичные HTTP(S)-адреса на стандартных портах.
SCOUT_TRUSTED_FETCH_ENDPOINTS=

# Предложение плана AI-001. Требует активного модуля ollama_framework и его модели.
SCOUT_AI_ENABLED=false
# Не задано — модель по умолчанию ollama_framework. Можно выбрать уже установленную модель отдельно для Scout.
SCOUT_AI_MODEL=
# Время ожидания модели в секундах. Диапазон от 1 до 60.
SCOUT_AI_TIMEOUT_SECONDS=15

# Экспериментальное локальное чтение текстовой CAPTCHA: это ещё не обход защиты сайта.
# Нужна операция ollama_framework.chat_local и локальный транспорт моста.
SCOUT_CAPTCHA_ML_ENABLED=false
# Явное имя уже установленной локальной модели с vision, без облачной подмены.
SCOUT_CAPTCHA_ML_MODEL=
SCOUT_CAPTCHA_ML_TIMEOUT_SECONDS=30

# Автоматический браузерный проход известной формы Checko (пока только без задания-картинки).
# Отдельная установка Chrome/Chromium обязательна; системный браузер не получает личный профиль.
SCOUT_BROWSER_ENABLED=false
SCOUT_BROWSER_CHANNEL=chrome
SCOUT_BROWSER_ORIGINS=[]
# Отдельные локальные ключи Fernet для cookies. Ниже не должны быть реальные реквизиты в Git.
SCOUT_BROWSER_KEYS={}
SCOUT_BROWSER_ACTIVE_KEY=

# HTTPS-прокси: включать после настройки доверенных IP:порт и TLS-имён.
# Поддерживаются auth_type=basic и none; ключ нужен также для привязки профиля none.
SCOUT_PROXY_ENABLED=0
SCOUT_PROXY_ENDPOINTS={}
# Отдельные ключи Fernet передаются локально, вне Git и резервных копий БД.
SCOUT_PROXY_KEYS={}
SCOUT_PROXY_ACTIVE_KEY=
SCOUT_PROXY_CHECK_URL=
